# ==========================================
# Ghostty Production Configuration
# ==========================================

# ----------- Theme & Color -----------
theme = Catppuccin Mocha

# ----------- Typography -----------
font-family = "JetBrainsMono Nerd Font"
font-size = 11
font-feature = +liga
font-feature = +calt

# ----------- Window Layout -----------
window-padding-x = 12
window-padding-y = 12
window-decoration = true
window-theme = dark

# ----------- Mouse & Clipboard -----------
copy-on-select = true
clipboard-trim-trailing-spaces = true
mouse-shift-capture = true

# ----------- Cursor Configuration -----------
cursor-style = block
cursor-style-blink = true

# ----------- Scrollback -----------
scrollback-limit = 20000